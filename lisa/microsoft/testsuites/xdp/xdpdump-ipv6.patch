+static __always_inline int ping_reply6(struct xdp_md *ctx)
+{
+	void *data_end = (void *)(long)ctx->data_end;
+	void *data = (void *)(long)ctx->data;
+	struct ethhdr *eth = data;
+	struct ipv6hdr *ip6h = (struct ipv6hdr *)(eth + 1);
+	struct icmp6hdr *icmp6h = (struct icmp6hdr *)(ip6h + 1);
+	__u32 checksum;
+	__u16 payload_len;
+
+	if (eth + 1 > data_end || ip6h + 1 > data_end ||
+	    icmp6h + 1 > data_end)
+		return XDP_PASS;
+
+	payload_len = bpf_ntohs(ip6h->payload_len);
+	if (ip6h->version != 6 || ip6h->nexthdr != IPPROTO_ICMPV6 ||
+	    payload_len < sizeof(*icmp6h) ||
+	    payload_len > data_end - (void *)icmp6h ||
+	    icmp6h->icmp6_type != ICMPV6_ECHO_REQUEST || icmp6h->icmp6_code != 0)
+		return XDP_PASS;
+
+	checksum = (~bpf_ntohs(icmp6h->icmp6_cksum) & 0xffff) +
+		   (~(ICMPV6_ECHO_REQUEST << 8) & 0xffff) +
+		   (ICMPV6_ECHO_REPLY << 8);
+	checksum = (checksum & 0xffff) + (checksum >> 16);
+	checksum = (checksum & 0xffff) + (checksum >> 16);
+
+	swap_mem(eth->h_dest, eth->h_source, ETH_ALEN);
+	swap_mem(&ip6h->saddr, &ip6h->daddr, sizeof(ip6h->saddr));
+	icmp6h->icmp6_type = ICMPV6_ECHO_REPLY;
+	icmp6h->icmp6_cksum = bpf_htons((__u16)~checksum);
+
+	return XDP_TX;
+}
 #endif
