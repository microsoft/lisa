+static __always_inline bool is_echo6(void *data, __u32 off, void *data_end)
+{
+	struct icmp6hdr *icmp6h = data + off;
+
+	if (icmp6h + 1 > data_end)
+		return false;
+
+	return icmp6h->icmp6_code == 0 &&
+	       (icmp6h->icmp6_type == ICMPV6_ECHO_REQUEST ||
+		icmp6h->icmp6_type == ICMPV6_ECHO_REPLY);
+}
+#endif
